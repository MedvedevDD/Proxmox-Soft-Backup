{
  "name": "telemt",
  "description": "Telemt proxy service and statistics helper",
  "packages": [],
  "services": ["telemt.service", "telemt-stats-helper.service"],
  "paths": [
    "/etc/telemt",
    "/opt/telemt",
    "/opt/telemt-stats-helper",
    "/usr/local/bin/telemt",
    "/usr/local/bin/telemt-stats-helper",
    "/var/lib/telemt",
    "/etc/systemd/system/telemt.service",
    "/etc/systemd/system/telemt-stats-helper.service",
    "/etc/systemd/system/telemt.service.d",
    "/etc/systemd/system/telemt-stats-helper.service.d"
  ]
}
